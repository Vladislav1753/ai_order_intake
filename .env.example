# Copy to .env. Leave MODEL_MODE=replay to run from saved responses without a key.
# Empty values fall back to the defaults in app/core/config.py.
MODEL_MODE=replay
# OpenAI chat model with tool calling and structured outputs (default gpt-4.1-mini).
MODEL_NAME=
# Needed only for MODEL_MODE=live. Never commit the real key.
MODEL_API_KEY=
DATABASE_URL=
