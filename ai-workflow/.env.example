# Environment variable names used by this exercise, without values.
# The runnable copy with defaults is ../.env.example; copy that one to ../.env.
MODEL_MODE=
MODEL_NAME=
MODEL_API_KEY=
DATABASE_URL=

# Optional application overrides (defaults in app/core/config.py).
MODEL_TEMPERATURE=
MODEL_MAX_TOKENS=
MODEL_TIMEOUT_S=
CATALOG_SEARCH_BUDGET=
MAX_CONCURRENCY=
DEBUG=

# Development only, not read by the application: the header value of the Context7 MCP
# server in the Claude Code user config (see README "Reproduce or replay").
CONTEXT7_API_KEY=
